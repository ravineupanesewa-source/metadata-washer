# CleanFrame configuration. All variables are optional; defaults shown.
# Values are validated at startup (src/lib/config/server-config.ts).

# Public origin of the deployed site, used for canonical URLs, Open Graph, sitemap.xml and
# robots.txt. Must be set at BUILD time (pages are prerendered). Defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://cleanframe.example.com

# Maximum size of a single image, in megabytes (max 512).
CLEANFRAME_MAX_FILE_SIZE_MB=25

# Maximum number of images the UI accepts per batch (max 200).
CLEANFRAME_MAX_FILES_PER_BATCH=20

# Images processed at the same time by this server process (also the ExifTool pool size).
CLEANFRAME_PROCESSING_CONCURRENCY=2

# Requests allowed to wait for a free slot before the server answers 503 BUSY.
CLEANFRAME_MAX_QUEUED_REQUESTS=20

# Per-step processing timeout in milliseconds.
CLEANFRAME_PROCESSING_TIMEOUT_MS=60000

# Absolute path for private per-request temp folders. Defaults to the OS temp dir.
# CLEANFRAME_TEMP_DIR=/var/tmp/cleanframe

# Absolute path to jpegtran (libjpeg-turbo) for lossless JPEG rotation in strict mode.
# Auto-detected on PATH when unset.
# CLEANFRAME_JPEGTRAN_PATH=/usr/bin/jpegtran
